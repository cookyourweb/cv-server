# .env.example
# Every variable is empty or set to the code's default. Never put secrets, real IDs or
# real webhook URLs here.

# ─── LLM (at least GROQ_API_KEY is required) ───
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
GROQ_MODEL=openai/gpt-oss-120b
# Backend of the LLM cascade (see llm.py and docs/ADR-004-llm-backend.md):
# "casera" (default, plain requests calls) or "litellm" (switched off by default).
LLM_BACKEND=casera

# ─── Per-document models (read by llm.py) ───
# CLAUDE_MODEL above is only a general FALLBACK. These two decide which model really
# writes each document. The code default for CV_MODEL is claude-haiku-4-5; production
# raises it to Sonnet through the environment (ADR-002).
CV_MODEL=claude-sonnet-4-6
CARTA_MODEL=claude-sonnet-4-6
# Minimum number of characters in an offer description for it to count as material to
# adapt. Below that, /generar-cv warns (it does not reject). See ADR-002.
DESCRIPCION_MINIMA=400

# ─── Google Drive (OAuth) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Drive folder IDs (anyone with the link can see them: do not commit them).
FOLDER_CV_MASTERS=
FOLDER_CV_GENERADOS=

# ─── Notion ───
NOTION_TOKEN=
# IDs of the Notion databases.
NOTION_DB_USUARIOS=
NOTION_DB_OFERTAS=

# ─── n8n ───
# Base URL of your n8n instance (required). The webhook URL is derived from it.
N8N_HOST=
# Optional. If unset, the code uses {N8N_HOST}/webhook/buscar-para-user.
# Uncomment it only to point at a different webhook (an empty variable overrides the default).
# WEBHOOK_BUSCAR_AHORA=
# Sent in the X-Webhook-Token header to the n8n webhook. Empty = no header.
N8N_WEBHOOK_TOKEN=
# Machine key (authentication ADR-003 in the buscartrabajo repo): n8n sends it in the
# X-Clave-Maquina header on calls to /registro, /generar-cv, /generar-carta,
# /crear-oferta, /buscar-ofertas-reales and /usuarios. Long random value. Without it
# those routes never open (fail closed).
CLAVE_MAQUINA=

# ─── User identity (Google token, see autenticacion.py) ───
# Web client id of the PANEL (not the GOOGLE_CLIENT_ID used for Drive, which is a
# different client).
OIDC_AUDIENCIA=
# Accepted issuers, comma-separated (published by the provider).
OIDC_EMISORES=
# URL of the provider's public keys (JWKS).
OIDC_JWKS_URL=
# Emails of the invited users, comma-separated. Empty = nobody gets in.
INVITADAS=
# Origins allowed by CORS on /yo and /health, comma-separated. Empty = none.
CORS_ORIGENES=

# ─── Encryption of stored CVs (ADR-007) ───
# AES-256-GCM keyring: version:key pairs, comma-separated. Each key is 32 random bytes
# in base64 (generate one with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())").
# Versions must be unique. The keys live OUTSIDE the database. Without a keyring nothing
# is encrypted or decrypted (fail closed).
CV_CLAVES=
# Keyring version used to encrypt new data. Older versions still decrypt.
CV_CLAVE_ACTIVA=

# ─── Database (Neon Postgres, ADR-002 amendment) ───
# Pooled connection string of the Neon branch the service uses. Never commit a real one.
# TLS is required unless the URL sets its own sslmode.
DATABASE_URL=
# Connection string used by the tests marked "bd" and by their migrations. Point it at a
# disposable branch, never at production. Those tests are skipped when it is empty.
# The destructive one (alembic downgrade base) also needs ALLOW_DESTRUCTIVE_DB_TESTS=1
# in the command environment; do not set that here.
DATABASE_URL_PRUEBAS=
