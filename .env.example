# .env.example
# ─── LLM (al menos GROQ_API_KEY es obligatoria) ───
GROQ_API_KEY=
GEMINI_API_KEY=
BREVO_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# ─── Modelos por documento (los lee cv_server_railway.py) ───
# CLAUDE_MODEL de arriba es solo el FALLBACK si Groq falla.
# Estas dos deciden quien escribe de verdad cada documento:
CV_MODEL=claude-sonnet-4-6
CARTA_MODEL=claude-sonnet-4-6
# Minimo de caracteres de la descripcion de una oferta para considerar que hay
# material que adaptar. Por debajo, /generar-cv avisa (no rechaza). Ver ADR-002.
DESCRIPCION_MINIMA=400

# ─── Google Drive (OAuth) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
