# .env.example
# Todas las variables van vacias o con el valor por defecto del codigo. Nunca pongas
# aqui secretos, IDs reales ni URLs de webhooks reales.

# ─── LLM (al menos GROQ_API_KEY es obligatoria) ───
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
GROQ_MODEL=openai/gpt-oss-120b
# Backend de la cascada LLM (ver llm.py y docs/ADR-004-backend-llm.md):
# "casera" (por defecto, peticiones con requests) o "litellm" (apagado por defecto).
LLM_BACKEND=casera

# ─── Modelos por documento (los lee llm.py) ───
# CLAUDE_MODEL de arriba es solo un FALLBACK general. Estas dos deciden quien
# escribe de verdad cada documento. El valor del codigo para CV_MODEL es
# claude-haiku-4-5; produccion lo sube a Sonnet por variable de entorno (ADR-002).
CV_MODEL=claude-sonnet-4-6
CARTA_MODEL=claude-sonnet-4-6
# Minimo de caracteres de la descripcion de una oferta para considerar que hay
# material que adaptar. Por debajo, /generar-cv avisa (no rechaza). Ver ADR-002.
DESCRIPCION_MINIMA=400

# ─── Google Drive (OAuth) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# IDs de carpeta de Drive (los ve cualquiera con el enlace: no los subas al repo).
FOLDER_CV_MASTERS=
FOLDER_CV_GENERADOS=

# ─── Notion ───
NOTION_TOKEN=
# IDs de las bases de datos de Notion.
NOTION_DB_USUARIOS=
NOTION_DB_OFERTAS=

# ─── n8n ───
# URL base de tu instancia de n8n (obligatoria). De aqui sale la URL del webhook.
N8N_HOST=
# Opcional. Si no la defines, el codigo usa {N8N_HOST}/webhook/buscar-para-user.
# Descomentala solo para apuntar a otro webhook (una variable vacia anula el defecto).
# WEBHOOK_BUSCAR_AHORA=
# Se envia en la cabecera X-Webhook-Token al webhook de n8n. Vacio = sin cabecera.
N8N_WEBHOOK_TOKEN=
# Clave de maquina (ADR-003 de autenticacion del repo buscartrabajo): la llevan en la
# cabecera X-Clave-Maquina las llamadas de n8n a /registro, /generar-cv,
# /generar-carta, /crear-oferta, /buscar-ofertas-reales y /usuarios. Valor largo y
# aleatorio. Sin ella esas rutas no abren nunca (falla cerrado).
CLAVE_MAQUINA=

# ─── Identidad de las usuarias (token de Google, ver autenticacion.py) ───
# Web client id del PANEL (no el GOOGLE_CLIENT_ID de Drive, que es otro cliente).
OIDC_AUDIENCIA=
# Emisores admitidos, separados por comas (los publica el proveedor).
OIDC_EMISORES=
# URL de las claves publicas (JWKS) del proveedor.
OIDC_JWKS_URL=
# Emails de las invitadas, separados por comas. Vacia = nadie entra.
INVITADAS=
# Origenes con CORS en /yo y /health, separados por comas. Vacio = ninguno.
CORS_ORIGENES=

# ─── Cifrado de los CV guardados (ADR-007) ───
# Llavero AES-256-GCM: pares version:clave, separados por comas. Cada clave son 32
# bytes aleatorios en base64 (genera una con: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())").
# Viven FUERA de la base de datos. Sin llavero no se cifra ni se descifra (falla cerrado).
CV_CLAVES=
# Version del llavero con la que se cifra lo nuevo. Las antiguas siguen descifrando.
CV_CLAVE_ACTIVA=
